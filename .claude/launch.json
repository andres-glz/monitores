{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "php",
      "runtimeArgs": ["-S", "127.0.0.1:8000", "-t", "api/public", "api/public/index.php"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "preview"],
      "port": 4173
    }
  ]
}
