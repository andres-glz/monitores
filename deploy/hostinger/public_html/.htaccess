# Configuración del sitio en Hostinger (raíz public_html)
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS (la cámara y la app sin conexión requieren HTTPS)
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # La API la atiende api/index.php (tiene su propio .htaccess)
  RewriteRule ^api(/|$) - [L]

  # Aplicación React: cualquier ruta que no sea un archivo existente carga index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Tipos de archivo que necesita la app
AddType application/wasm .wasm
AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  # index.html y el service worker siempre se revisan para detectar versiones nuevas
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Los archivos de /assets llevan hash en el nombre: se pueden guardar un año
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
