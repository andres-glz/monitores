# Entorno: local | production
# En Hostinger usa APP_ENV=production y APP_DEBUG=false (la cookie de sesión exige HTTPS)
APP_ENV=local
APP_DEBUG=true

# Conexión a MySQL
# En Hostinger: DB_HOST=localhost y los datos de hPanel > Bases de datos (p. ej. u123456789_monitores)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=monitores
DB_USER=root
DB_PASS=

# Días que dura la sesión sin volver a iniciar sesión (se renueva con el uso)
AUTH_TOKEN_DAYS=30
